# Copie para .env e preencha. Nenhuma destas variáveis é secreta (vão para o navegador).

# Google Tag Manager (opcional). Sem ID, nenhum script de terceiros é carregado.
# O site atual usa GTM-KHSJ6MBS — confirme com quem gerencia os anúncios.
VITE_GTM_ID=

# Endpoint de catálogo (opcional). Padrão: /data/catalog.json
VITE_CATALOG_URL=
